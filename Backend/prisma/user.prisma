// User
// Source: /Docs/InitialDB-plan.md - "User"

model User {
  id String @id @default(uuid()) @db.Uuid

  /// The name other people find this account by, spelled the way its owner
  /// spells it. 3-24 chars, `[a-zA-Z0-9_-]`.
  ///
  /// **Unique, at the database level** — see `usernameKey`, which is what the
  /// constraint is actually on. The social layer's whole discovery model is
  /// "type a username", and a username that can name two accounts is not a way
  /// to find someone; it is a way to visit the wrong person's room.
  username String

  /// `username` lowercased. The column the uniqueness is really on.
  ///
  /// Two columns for one fact, deliberately, and this is the argument. The
  /// constraint has to be **case-insensitive** — `Kass` and `kass` naming two
  /// accounts is the same failure as two `kass`es — and the natural expression
  /// of that is a unique index on `lower(username)`. Prisma cannot declare a
  /// functional index, so the next `prisma migrate dev` would generate a
  /// migration dropping it again; that is the same trap documented on
  /// `FocusSession` (11-schema-additions.md §6), and it is not a trap worth
  /// walking into for the one column the entire social layer is keyed on.
  ///
  /// A plain column Prisma understands cannot be dropped behind our backs, and
  /// it makes the lookup an index hit rather than a `mode: 'insensitive'` scan.
  /// `UsersService.setUsername` is the only writer, and it writes both.
  usernameKey String @unique

  email String

  /// Which saved pet the user is currently looking after.
  ///
  /// A pointer on the user rather than a flag on the pet: "exactly one active"
  /// is then a property of the schema instead of something every write has to
  /// remember to maintain. Nulled automatically when that pet is deleted.
  activePetId String? @db.Uuid
  activePet   Pet?    @relation("ActivePet", fields: [activePetId], references: [id], onDelete: SetNull)

  /// How the creature feels about the user, 0..1.
  ///
  /// On the user rather than on the pet, which is a deviation from the brief
  /// worth defending. `Pet` rows are saved *presets* — a library the creature
  /// editor writes to (see `src/pets/pets.service.ts`), which a user may have
  /// none of and may delete at will. Affection is not a fact about a rig; it is
  /// the state of a relationship built out of goals kept and sessions served,
  /// and hanging it off a preset would mean it reset when somebody re-saved
  /// their creature with different ears.
  ///
  /// Never written directly from a request. `AffectionService` is the only
  /// writer, and it only ever moves this by a few hundredths at a time.
  affection Float @default(0.5)

  /// When `affection` was last brought up to date.
  ///
  /// Decay is computed rather than ticked: nothing runs on a schedule, and the
  /// value is settled lazily on the next read (`AffectionService.read`). This
  /// is the column that makes that possible, and the reason no cron job exists.
  affectionAt DateTime @default(now())

  /// The last time the user actually followed through — finished a session or
  /// finished a goal.
  ///
  /// Separate from `affectionAt` because they answer different questions.
  /// `affectionAt` is bookkeeping; this is the one the product has an opinion
  /// about, and the opinion is that a fortnight away is a break rather than
  /// neglect (`affection.ts`, GRACE_DAYS).
  lastFollowThroughAt DateTime?

  /// --- Progress (the rewarding system) -------------------------------------
  ///
  /// Three counters, and they are the *only* thing standing between a user and
  /// the locked half of the object catalog. Stored rather than aggregated on
  /// demand, for the same reason `affection` is stored rather than replayed
  /// from the sessions that caused it: they are read on every room panel and on
  /// every visit, they are written by exactly the code that causes them, and a
  /// `SUM` over a lifetime of focus sessions is a query that gets slower every
  /// week the product succeeds.
  ///
  /// The rule that keeps them honest: **nothing that arrives in a request body
  /// can move these.** `FocusService.seal`, `GoalsService.complete` /
  /// `reopen`, and `MemoriesService` are the four writers, each inside the
  /// transaction that records the thing the number is about — so a session that
  /// was served but not counted, or counted twice by a double-clicked button,
  /// is not a state this schema can be left in.

  /// Minutes actually served, summed over every completed focus session.
  ///
  /// Only ever goes up. A session abandoned half way adds nothing (the time was
  /// not served) and deleting the goal it was against adds nothing back — the
  /// afternoon still happened, which is the same reasoning that makes
  /// `FocusSession.goalId` nullable rather than cascading.
  focusMinutes Int @default(0)

  /// Goals finished. Decremented by `reopen`, floored at zero.
  ///
  /// Symmetric with affection, and for the same reason: without the decrement,
  /// a checkbox pressed forty times unlocks the whole catalog in a minute.
  /// Deleting a completed goal does *not* decrement it — tidying a list is not
  /// un-finishing the thing.
  goalsCompleted Int @default(0)

  /// How many memories are public **right now**.
  ///
  /// The one counter that can go down, because it is a description of a current
  /// state rather than a tally of past events: a user who takes a memory back
  /// has one fewer shared, and a stats tab that claimed otherwise would be
  /// lying to the visitor reading it. This is also the column
  /// `PublicUserView.publicMemories` is built from — there is one number for
  /// "how many has this person shared", not two that can disagree.
  memoriesShared Int @default(0)

  pets           Pet[]
  environments   Environment[]
  memories       Memory[]
  inventoryItems InventoryItem[]
  goals          Goal[]
  focusSessions  FocusSession[]

  // --- The social layer (13-social-endpoints.md) ---------------------------
  // Two relations per symmetric relationship, because a relationship between
  // two users is one row that both of them are on, and Prisma needs a name for
  // each side of it.
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  parksHosted      Park[]
  parkMemberships  ParkParticipant[]
  parkMessages     ParkMessage[]

  conversationsAsA Conversation[]  @relation("ConversationA")
  conversationsAsB Conversation[]  @relation("ConversationB")
  directMessages   DirectMessage[]
}
