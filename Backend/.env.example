# Copy to .env and fill in real values. See Backend/.env for local dev values
# (gitignored) — this file only documents what's required.

DATABASE_URL="postgresql://user:password@localhost:5432/PETWEB"

# --- Server ---
PORT=3000

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- CORS ---
FRONTEND_URL="http://localhost:5173"

# --- Mail ---
# One SMTP URL rather than five variables, because that is the shape a mail
# provider hands you. `smtps://` is implicit TLS on 465; `smtp://` on 587
# upgrades with STARTTLS. Verification codes are the only mail this sends.
SMTP_URL="smtp://user:password@smtp.example.com:587"
MAIL_FROM="Pocus <no-reply@your-domain>"

# Refuse to create accounts when there is no mail server, instead of printing
# the verification code to the server log. Set this in every deployment; leave
# it unset locally so the app can be run without a mail account.
MAIL_REQUIRED=0
