# Copy to .env and fill in real values. See Backend/.env for local dev values
# (gitignored) — this file only documents what's required.

DATABASE_URL="postgresql://user:password@localhost:5432/PETWEB"

# --- Server ---
PORT=3000

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- CORS ---
FRONTEND_URL="http://localhost:5173"

# --- Mail ---
# Nothing. This application sends no email.
#
# It briefly did: sign-up required a six-digit code mailed to the address, over
# nodemailer and an SMTP_URL. That is removed until further notice — sign-up
# creates a session immediately and an address only has to look like one. If it
# comes back, `git log -- Backend/src/auth/mailer.ts` has the transport, the
# template and the provider notes that were here.
