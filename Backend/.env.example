# Copy to .env and fill in real values. See Backend/.env for local dev values
# (gitignored) — this file only documents what's required.

DATABASE_URL="postgresql://user:password@localhost:5432/PETWEB"

# --- Server ---
PORT=3000

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- CORS ---
FRONTEND_URL="http://localhost:5173"

# --- Mail ---
# Verification codes are the only mail this application sends.
#
# LEAVE SMTP_URL UNSET IN DEVELOPMENT and codes go to a throwaway Ethereal
# inbox: the backend logs the code AND a URL where the rendered email can be
# read. Nothing to sign up for. That is the default and it needs no config.
#
# For real delivery, one URL — which is the shape every provider hands you.
# `smtp://` on 587 upgrades with STARTTLS; `smtps://` is implicit TLS on 465.
# The password almost always contains characters that have to be percent-encoded
# (@ becomes %40, : becomes %3A), so encode it rather than pasting it raw.
#
#   Brevo      smtp://you%40example.com:SMTP_KEY@smtp-relay.brevo.com:587
#              300/day free, no domain needed to start
#   Resend     smtp://resend:re_YOUR_KEY@smtp.resend.com:587
#              free tier, but sending to addresses other than your own needs a
#              verified domain
#   Gmail      smtp://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:587
#              needs 2-Step Verification on, then an App Password. Not your
#              account password, which will not work
#   Mailtrap   smtp://USER:PASS@sandbox.smtp.mailtrap.io:2525
#              a catcher, like Ethereal — nothing reaches a real inbox
#
# SMTP_URL="smtp://user:password@smtp.example.com:587"

# The From address. With most providers this has to be on a domain you have
# verified with them, or the message is rejected or silently spam-filed.
MAIL_FROM="Pocus <no-reply@your-domain>"

# Set this to 1 in every deployment. It refuses sign-up when there is no
# SMTP_URL, instead of falling back to Ethereal and logging codes — both of
# which are development conveniences and neither of which belongs in production.
MAIL_REQUIRED=0
